<%- include("./partials/header") %>

<%
let subtotal = 0;
const platformFee = 20;

user.cart.forEach(product => {
    if(product.discount && product.discount > 0){
        subtotal += product.price - product.discount;
    } else {
        subtotal += product.price;
    }
});

const total = subtotal + platformFee;
%>
<div class="w-full min-h-screen bg-zinc-100 p-10">

    <h1 class="text-4xl font-bold mb-8">My Cart</h1>

    <% if(user.cart.length === 0){ %>

        <div class="bg-white rounded-xl shadow-md p-12 text-center">
            <h2 class="text-3xl font-semibold">Your Cart is Empty</h2>
            <p class="text-gray-500 mt-3">Looks like you haven't added anything yet.</p>

            <a href="/shop"
                class="inline-block mt-6 bg-black text-white px-6 py-3 rounded-lg hover:bg-zinc-800 transition">
                Continue Shopping
            </a>
        </div>

    <% } else { %>

    <div class="flex gap-8">

        <!-- Cart Products -->
        <div class="w-[70%] space-y-6">

            <% user.cart.forEach(function(product){ %>

            <div class="bg-white rounded-xl shadow-md overflow-hidden flex">

                <!-- Image -->
                <div
                    class="w-64 h-56 flex items-center justify-center"
                    style="background-color:<%= product.bgcolor %>;"
                >
                    <img
                        src="data:<%= product.image.contentType %>;base64,<%= product.image.data.toString('base64') %>"
                        alt="<%= product.name %>"
                        class="h-44 object-contain"
                    >
                </div>

                <!-- Details -->
                <div class="flex-1 p-6 flex flex-col justify-between">

                    <div>
                        <h2 class="text-2xl font-bold">
                            <%= product.name %>
                        </h2>

                        <% if(product.description){ %>
                            <p class="text-gray-500 mt-2">
                                <%= product.description %>
                            </p>
                        <% } %>
                    </div>

                    <div class="flex items-center justify-between">

                        <div>

                            <% if(product.discount && product.discount > 0){ %>

                                <h3 class="text-2xl font-bold text-green-600">
                                    ₹<%= product.price-product.discount %>
                                </h3>

                                <p class="line-through text-gray-400">
                                    ₹<%= product.price %>
                                </p>

                            <% } else { %>

                                <h3 class="text-2xl font-bold">
                                    ₹<%= product.price %>
                                </h3>

                            <% } %>

                        </div>

                        <div class="flex gap-3">
                            <a
                                href="/removefromcart/<%= product._id %>"
                                class="bg-red-500 hover:bg-red-600 text-white px-5 py-2 rounded-lg"
                            >
                                Remove
                            </a>
                        </div>

                    </div>

                </div>

            </div>

            <% }) %>

        </div>

        <!-- Price Details -->
        <div class="w-[30%]">

            <div class="bg-white rounded-xl shadow-md p-6 sticky top-8">

                <h2 class="text-2xl font-bold mb-6">
                    Price Details
                </h2>

                <div class="space-y-4">

                    <div class="flex justify-between">
                        <span>Total Products</span>
                        <span><%= user.cart.length %></span>
                    </div>

                    <div class="flex justify-between">
                        <span>Subtotal</span>
                        <span>₹ <%= subtotal %></span>
                    </div>

                    <div class="flex justify-between">
                        <span>Platform Fee</span>
                        <span>₹ <%= platformFee %></span>
                    </div>

                    <div class="flex justify-between">
                        <span>Shipping</span>
                        <span class="text-green-600 font-semibold">FREE</span>
                    </div>

                    <hr class="my-3">

                    <div class="flex justify-between text-xl font-bold">
                        <span>Total Amount</span>
                        <span>₹ <%= total %></span>
                    </div>

                </div>

                <button
                    class="w-full mt-8 bg-black text-white py-3 rounded-lg hover:bg-zinc-800 transition"
                >
                    Proceed to Checkout
                </button>

            </div>

        </div>

    </div>

    <% } %>

</div>

<%- include("./partials/footer") %>