<%- include("./partials/header") %>

<%- include("./partials/header") %>

<% if (success && success.length > 0) { %>
    <div class="mx-10 mt-6 bg-green-500 text-white px-4 py-3 rounded-md">
        <%= success[0] %>
    </div>
<% } %>

<div class="w-full min-h-screen flex px-10 py-10 gap-10">
<div class="w-full min-h-screen flex px-10 py-10 gap-10">

    <!-- Sidebar -->
    <div class="w-64 shrink-0">

        <div class="flex items-center gap-3">
            <h3 class="text-lg">Sort by</h3>

            <select class="border border-gray-300 px-3 py-2 rounded-md outline-none">
                <option>Popular</option>
                <option>Newest</option>
                <option>Price: Low to High</option>
                <option>Price: High to Low</option>
            </select>
        </div>

        <div class="mt-20">
            <h3 class="font-semibold mb-4">Collections</h3>

            <div class="flex flex-col gap-3">
                <a href="#" class="hover:text-red-500">New Collection</a>
                <a href="#" class="hover:text-red-500">All Products</a>
                <a href="#" class="hover:text-red-500">Discounted Products</a>
            </div>
        </div>

        <div class="mt-20">
            <h3 class="font-semibold mb-4">Filter by</h3>

            <div class="flex flex-col gap-3">
                <a href="#" class="hover:text-red-500">Availability</a>
                <a href="#" class="hover:text-red-500">Discount</a>
            </div>
        </div>

    </div>

    <!-- Products -->
    <div class="flex-1">

        <% if(products && products.length > 0){ %>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

            <% products.forEach(function(product){ %>

            <div class="bg-white shadow rounded-lg overflow-hidden">

                <div
                    class="h-64 flex items-center justify-center "
                    style="background-color:<%= product.bgcolor %>;"
                >
                    <img
                        src="data:<%= product.image.contentType %>;base64,<%= product.image.data.toString('base64') %>"
                        alt="<%= product.name %>"
                        class="h-48 object-contain"
                    />
                </div>

                <div
                    class="p-5 flex justify-between items-center"
                    style="background-color:<%= product.panelcolor %>; color:<%= product.textcolor %>;"
                >

                    <div>
                        <h2 class="font-semibold text-lg">
                            <%= product.name %>
                        </h2>

                        <% if(product.discount && product.discount > 0){ %>

                            <p class="font-semibold">
                                ₹<%= product.discount %>
                            </p>

                            <p class="line-through text-sm opacity-60">
                                ₹<%= product.price %>
                            </p>

                        <% } else { %>

                            <p class="font-semibold">
                                ₹<%= product.price %>
                            </p>

                        <% } %>
                    </div>

                    <a
                        class="w-10 h-10 rounded-full bg-white text-black flex items-center justify-center hover:bg-gray-200" href="/addtocart/<%=product._id%>"
                    >
                        <i class="ri-add-line"></i>
                     </a>

                </div>

            </div>

            <% }) %>

        </div>

        <% } else { %>

            <div class="text-center text-xl mt-20">
                No Products Found
            </div>

        <% } %>

    </div>

</div>

<%- include("./partials/footer") %>