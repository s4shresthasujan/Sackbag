<%- include("./partials/header") %>

<div class="w-full min-h-screen flex px-10 py-10 gap-10">

    <!-- Sidebar -->
    <div class="w-64 shrink-0">

        <div class="flex items-center gap-3">
            <h3 class="text-lg">Sort by</h3>

            <select class="border border-gray-300 px-3 py-2 rounded-md outline-none">
                <option>Popular</option>
                <option>Newest</option>
                <option>Price: Low to High</option>
                <option>Price: High to Low</option>
            </select>
        </div>

        <div class="mt-20">
            <h3 class="font-semibold mb-4">Collections</h3>

            <div class="flex flex-col gap-3">
                <a href="#" class="hover:text-red-500">New Collection</a>
                <a href="#" class="hover:text-red-500">All Products</a>
                <a href="#" class="hover:text-red-500">Discounted Products</a>
            </div>
        </div>

        <div class="mt-20">
            <h3 class="font-semibold mb-4">Filter by</h3>

            <div class="flex flex-col gap-3">
                <a href="#" class="hover:text-red-500">Availability</a>
                <a href="#" class="hover:text-red-500">Discount</a>
            </div>
        </div>

    </div>

    <!-- Products -->
    <div class="flex-1">

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

            <% for(let i=0;i<8;i++){ %>

            <div class="bg-white">

                <div class="h-64 bg-yellow-400 flex items-center justify-center">
                    <img
                        src="https://placehold.co/200x220"
                        alt="product"
                        class="h-48 object-contain"
                    >
                </div>

                <div class="bg-red-500 text-black p-5 flex justify-between items-center">

                    <div>
                        <h2 class="font-semibold text-lg">Clinge Bag</h2>
                        <p class="text-lg font-medium">₹1200</p>
                    </div>

                    <button
                        class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-xl hover:bg-gray-100 transition"
                    >
                        <i class="ri-add-line"></i>
                    </button>

                </div>

            </div>

            <% } %>

        </div>

    </div>

</div>

<%- include("./partials/footer") %>